# Filled by `npx convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Filled by Convex-managed WorkOS when you run `npx convex dev`
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback

# Seals the httpOnly auth session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
